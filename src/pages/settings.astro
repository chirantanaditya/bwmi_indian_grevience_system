---
import "../styles/tailwind.css";
import "../styles/global.css";
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Settings — IGS</title></head><body><main class="settings-page"><a href="/">← Back to IGS</a><h1>Account settings</h1><section><h2 id="name">Loading…</h2><p id="email"></p><p>Your account details are used only to submit and track your public-service cases in this prototype.</p><hr /><h2 id="notifications">Notifications</h2><p>Case registration and status updates are sent to this email address when notifications are configured.</p></section></main><script is:inline>fetch("/api/auth/get-session",{credentials:"include"}).then(async response=>{const data=await response.json();if(!data.user){window.location.assign("/sign-in");return}document.getElementById("name").textContent=data.user.name;document.getElementById("email").textContent=data.user.email})</script><style is:global>.settings-page{width:min(680px,100%);margin:0 auto;padding:48px 22px}.settings-page a{color:var(--ink)}.settings-page h1{margin:28px 0}.settings-page section{padding:24px;border:1px solid var(--line);border-radius:16px;background:var(--active)}</style></body></html>