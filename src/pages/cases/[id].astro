---
import "../../styles/tailwind.css";
import "../../styles/global.css";
const { id } = Astro.params;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Case details — IGS</title></head><body><main class="case-detail"><a href="/">← Back to IGS</a><h1>Case details</h1><p id="caseStatus" aria-live="polite">Loading your case…</p><section id="caseCard" hidden><h2 id="caseDepartment"></h2><p id="caseIssue"></p><p id="caseReason"></p><h3>Journey</h3><ol id="caseTimeline"></ol></section></main><script is:inline define:vars={{ id }}>fetch(`/api/cases/${id}`,{credentials:"include"}).then(async response=>{const data=await response.json();if(!response.ok)throw new Error(data.error);document.getElementById("caseStatus").textContent=data.case.status;document.getElementById("caseDepartment").textContent=data.case.department;document.getElementById("caseIssue").textContent=data.case.issue;document.getElementById("caseReason").textContent=data.case.reason;const list=document.getElementById("caseTimeline");data.timeline.forEach(event=>{const item=document.createElement("li"),label=document.createElement("strong");label.textContent=event.event_type;item.append(label,document.createTextNode(` — ${event.message}`));list.append(item)});document.getElementById("caseCard").hidden=false}).catch(error=>{document.getElementById("caseStatus").textContent=error.message})</script><style is:global>.case-detail{width:min(760px,100%);margin:0 auto;padding:48px 22px}.case-detail a{color:var(--ink)}.case-detail h1{margin:28px 0}.case-detail section{margin-top:24px;padding:24px;border:1px solid var(--line);border-radius:16px;background:var(--active)}.case-detail li{margin:12px 0}</style></body></html>