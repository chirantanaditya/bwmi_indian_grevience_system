---
import "../styles/tailwind.css";
import "../styles/global.css";
import CitizenSidebar from "../components/citizen-sidebar";
import RoutingProgress from "../components/routing-progress";
import { auth, db } from "../lib/auth";
const recentCases: string[] = [];
const session = await auth.api.getSession({ headers: Astro.request.headers });
const sidebarCases = session
  ? await db.query("SELECT id, issue, department, status FROM citizen_cases WHERE user_id = $1 ORDER BY created_at DESC LIMIT 4", [session.user.id]).then((result) => result.rows).catch(() => [])
  : [];
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="A simple civic workspace for getting help with public services." /><title>IGS — Citizen help</title></head><body>
<script is:inline>document.addEventListener("DOMContentLoaded",()=>{const style=document.createElement("style");style.textContent=`.language-menu{position:absolute;z-index:30;top:64px;right:72px;display:grid;gap:4px;min-width:152px;padding:8px;border:1px solid var(--line);border-radius:10px;background:var(--paper);box-shadow:0 12px 28px rgba(0,0,0,.14)}.language-menu[hidden]{display:none}.language-menu button{padding:9px 10px;border:0;border-radius:6px;background:transparent;color:var(--ink);text-align:left;font:inherit}.language-menu button:hover{background:var(--rail)}html[data-text-scale="1"] h1{font-size:clamp(48px,4.7vw,70px)}html[data-text-scale="2"] h1{font-size:clamp(54px,5.4vw,80px)}html[data-text-scale="1"] .helper,html[data-text-scale="1"] .issue-composer textarea{font-size:21px}html[data-text-scale="2"] .helper,html[data-text-scale="2"] .issue-composer textarea{font-size:24px}html[data-text-scale="1"] .nav-link,html[data-text-scale="1"] .recent-list a{font-size:17px}html[data-text-scale="2"] .nav-link,html[data-text-scale="2"] .recent-list a{font-size:19px}@media(max-width:820px){.language-menu{top:60px;right:57px}html[data-text-scale="1"] h1{font-size:clamp(42px,10vw,58px)}html[data-text-scale="2"] h1{font-size:clamp(46px,11vw,64px)}}`;document.head.append(style);const langButton=document.querySelector(".utility-actions .icon-button:not(#themeToggle)"),typeButton=document.getElementById("typeToggle"),menu=document.createElement("div");menu.className="language-menu";menu.hidden=true;menu.innerHTML='<button type="button" data-language="en">English</button><button type="button" data-language="hi">हिन्दी</button>';document.body.append(menu);const copy={en:{"New chat":"New chat","Grievances":"Grievances","RTI applications":"RTI applications","Appeals":"Appeals","Active last 30 days":"Active last 30 days","No active cases yet.":"No active cases yet.","Describe your issue":"Describe your issue","Use your own words. We’ll help identify the right next step.":"Use your own words. We’ll help identify the right next step.","How can we help you?":"How can we help you?"},hi:{"New chat":"नई बातचीत","Grievances":"शिकायतें","RTI applications":"आरटीआई आवेदन","Appeals":"अपीलें","Active last 30 days":"पिछले 30 दिनों में सक्रिय","No active cases yet.":"अभी कोई सक्रिय मामला नहीं है।","Describe your issue":"अपनी समस्या बताएं","Use your own words. We’ll help identify the right next step.":"अपने शब्दों में लिखें। हम सही अगला कदम ढूँढने में मदद करेंगे।","How can we help you?":"हम आपकी कैसे मदद कर सकते हैं?"}};function setLanguage(language){document.documentElement.lang=language;document.querySelectorAll(".nav-link span,.recent-section h2,.empty-cases,h1,.helper").forEach(node=>{const english=Object.keys(copy.en).find(key=>node.textContent.trim()===key||node.dataset.en===key);if(english){node.dataset.en=english;node.textContent=copy[language][english]}});const input=document.getElementById("issueText"),english="How can we help you?";input.dataset.en=english;input.placeholder=copy[language][english];menu.hidden=true;langButton.setAttribute("aria-label",language==="hi"?"Change language — Hindi":"Change language — English")}langButton.addEventListener("click",()=>{menu.hidden=!menu.hidden});menu.addEventListener("click",event=>{const language=event.target.dataset.language;if(language)setLanguage(language)});let scale=0;typeButton.addEventListener("click",()=>{scale=(scale+1)%3;document.documentElement.dataset.textScale=String(scale);typeButton.setAttribute("aria-label",scale===0?"Increase text size":scale===1?"Increase text size again":"Reset text size")});});</script><a class="skip-link" href="#issue">Skip to describe your issue</a><div class="app-shell">
<CitizenSidebar client:load user={session?.user ? { name: session.user.name, email: session.user.email } : null} cases={sidebarCases} /><aside class="sidebar" aria-label="Citizen navigation" hidden><div class="brand-row"><a class="wordmark" href="/" aria-label="IGS home">IGS</a><button class="icon-button search-button" type="button" aria-label="Search your cases"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg></button></div>
<nav class="primary-nav" aria-label="Your workspace"><a class="nav-link active" href="#issue"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 4H6.8A2.8 2.8 0 0 0 4 6.8v10.4A2.8 2.8 0 0 0 6.8 20h10.4a2.8 2.8 0 0 0 2.8-2.8v-6.7"></path><path d="m13 7 4-4 3 3-4 4-4 1z"></path><path d="M8 13h4M8 16h6"></path></svg><span>New chat</span></a><a class="nav-link" href="#recent-cases"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 4H6.8A2.8 2.8 0 0 0 4 6.8v10.4A2.8 2.8 0 0 0 6.8 20h10.4a2.8 2.8 0 0 0 2.8-2.8v-6.7"></path><path d="m13 7 4-4 3 3-4 4-4 1z"></path></svg><span>Grievances</span></a><a class="nav-link" href="#recent-cases"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 4H6.8A2.8 2.8 0 0 0 4 6.8v10.4A2.8 2.8 0 0 0 6.8 20h10.4a2.8 2.8 0 0 0 2.8-2.8v-6.7"></path><path d="m13 7 4-4 3 3-4 4-4 1z"></path></svg><span>RTI applications</span></a><a class="nav-link" href="#recent-cases"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 4H6.8A2.8 2.8 0 0 0 4 6.8v10.4A2.8 2.8 0 0 0 6.8 20h10.4a2.8 2.8 0 0 0 2.8-2.8v-6.7"></path><path d="m13 7 4-4 3 3-4 4-4 1z"></path></svg><span>Appeals</span></a></nav>
<section id="recent-cases" class="recent-section" aria-labelledby="recent-title"><h2 id="recent-title">Active last 30 days</h2><div class="recent-list">{recentCases.length ? recentCases.map((caseTitle) => <a href="#issue" title={caseTitle}>{caseTitle}</a>) : <p class="empty-cases">No active cases yet.</p>}</div></section>
<a class="profile-card sign-in-link" href="/sign-in" aria-label="Sign in to access your cases" style="text-decoration:none"><span class="profile-avatar" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg></span><span class="profile-copy"><strong>Sign in</strong><small>Access your cases and updates</small></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></aside>
<div class="main-area"><header class="utility-bar"><div class="utility-actions"><button class="icon-button" id="themeToggle" type="button" aria-label="Switch to dark mode"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun-icon lucide-sun" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg></button><button class="icon-button" type="button" aria-label="Change language"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-languages-icon lucide-languages" aria-hidden="true"><path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/></svg></button><button class="type-button" id="typeToggle" type="button" aria-label="Increase text size"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-a-large-small-icon lucide-a-large-small" aria-hidden="true"><path d="m15 16 2.536-7.328a1.02 1.02 0 1 1.928 0L22 16"/><path d="M15.697 14h5.606"/><path d="m2 16 4.039-9.69a.5.5 0 0 1 .923 0L11 16"/><path d="M3.304 13h6.392"/></svg></button></div></header>
<style is:global>.type-button svg{width:27px;height:27px;stroke:currentColor;fill:none}</style><main class="welcome-panel"><section class="issue-intro" aria-labelledby="issue-title"><p class="kicker">Citizen support</p><h1 id="issue-title">Describe your issue</h1><p class="helper">Use your own words. We’ll help identify the right next step.</p></section><form id="issue" class="issue-composer" aria-label="Describe your issue"><label class="sr-only" for="issueText">How can we help you?</label><textarea id="issueText" name="issue" rows="3" placeholder="How can we help you?"></textarea><div class="composer-actions"><div class="composer-tools"><button id="sendButton" class="send-button" type="submit" aria-label="Start getting help"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button></div></div></form><p id="formMessage" class="form-message" aria-live="polite"></p><p class="prototype-note">Prototype using public authority lists. It is not an official government service.</p><RoutingProgress client:load /></main></div></div>
<style is:global>.app-shell{display:flex;min-height:100vh}.main-area{flex:1;min-width:0}.app-shell>aside[hidden]{display:none}.sidebar-collapsed .app-shell{grid-template-columns:0 minmax(0,1fr)}.sidebar-collapsed .sidebar{overflow:hidden;padding-left:0;padding-right:0;border-right:0;opacity:0;pointer-events:none}.dark-mode{color-scheme:dark;--paper:#171817;--rail:#20211f;--ink:#f4f4f0;--muted:#b5b5af;--line:#42433f;--line-soft:#343531;--active:#2a2b28;--focus:#7fc6ff}.dark-mode .nav-link{color:var(--ink)}.dark-mode .nav-link:hover{background:#30312e}.dark-mode .profile-card,.dark-mode .issue-composer{background:#222320;border-color:#4b4c47}.dark-mode .profile-card{color:var(--ink)}.dark-mode .issue-composer textarea{color:var(--ink)}.dark-mode .issue-composer textarea::placeholder{color:#a2a29c}.dark-mode h1{color:var(--ink)}.dark-mode .send-button{background:#f4f4f0;color:#151515}.dark-mode .send-button:hover{background:#fff}.dark-mode .icon-button,.dark-mode .tool-button,.dark-mode .type-button{color:#c8c8c2}.dark-mode .recent-list a{color:#dbdbd5}.dark-mode .profile-card svg{stroke:#ccc}.dark-mode .issue-composer:focus-within{border-color:#b9b9b1}.dark-mode .form-message{color:#c4c4bd}.empty-cases{margin:0;color:var(--muted);font-size:14px;line-height:1.4}html[data-text-scale="1"]{font-size:112.5%}html[data-text-scale="2"]{font-size:125%}</style><script is:inline>const form=document.getElementById("issue"),issueText=document.getElementById("issueText"),formMessage=document.getElementById("formMessage"),themeToggle=document.getElementById("themeToggle"),sidebarToggle=document.getElementById("sidebarToggle"),typeToggle=document.getElementById("typeToggle");let textScale=0;form.addEventListener("submit",async e=>{e.preventDefault();const t=issueText.value.trim();const submit=document.getElementById("sendButton");if(!t){formMessage.textContent="Describe what happened so we can help you find the right service.";issueText.focus();return}submit.disabled=true;formMessage.textContent="Finding the right route…";try{const routed=await fetch("/api/route",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({issue:t})});const route=await routed.json();if(!routed.ok)throw new Error(route.error||"We could not route this issue.");formMessage.textContent="Saving your case…";const saved=await fetch("/api/cases",{method:"POST",credentials:"include",headers:{"Content-Type":"application/json"},body:JSON.stringify({issue:t,route})});const result=await saved.json();if(saved.status===401){window.location.assign("/sign-in");return}if(!saved.ok)throw new Error(result.error||"We could not save this case.");formMessage.textContent="";window.dispatchEvent(new CustomEvent("igs:routing",{detail:{issue:t,...route,caseId:result.caseId}}))}catch(error){formMessage.textContent=error instanceof Error?error.message:"We could not submit this issue."}finally{submit.disabled=false}});themeToggle.addEventListener("click",()=>{const dark=document.documentElement.classList.toggle("dark-mode");themeToggle.setAttribute("aria-label",dark?"Switch to light mode":"Switch to dark mode")});sidebarToggle?.addEventListener("click",()=>window.igsToggleSidebar?.());typeToggle.addEventListener("click",()=>{textScale=(textScale+1)%3;document.documentElement.dataset.textScale=String(textScale);typeToggle.setAttribute("aria-label",textScale===0?"Increase text size":textScale===1?"Increase text size again":"Reset text size")});</script><script is:inline>
  (() => {
    const sidebar = document.querySelector('[data-slot="sidebar"]');
    const headerToggle = document.getElementById("sidebarToggle");
    const innerToggle = document.getElementById("shadcnSidebarToggle");
    window.igsToggleSidebar = () => {
      if (!sidebar) return;
      const collapsed = sidebar.getAttribute("data-state") !== "collapsed";
      sidebar.setAttribute("data-state", collapsed ? "collapsed" : "expanded");
      sidebar.setAttribute("data-collapsible", collapsed ? "icon" : "");
      headerToggle?.setAttribute("aria-expanded", String(!collapsed));
      headerToggle?.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
    };
    innerToggle?.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopImmediatePropagation();
      window.igsToggleSidebar();
    }, true);
  })();
</script><style is:global>.utility-actions{align-items:center;gap:4px;margin-right:12px}.utility-actions>*{width:44px!important;height:44px!important;border-left:0!important}.utility-actions .icon-button svg,.type-button svg{width:22px!important;height:22px!important}</style><style is:global>.routing-progress{width:min(100%,1120px);margin:32px 0 0}.routing-request,.routing-confirmation{margin:0;border:1px solid var(--line);border-radius:18px;background:var(--active)}.routing-request{padding:18px 22px;color:var(--muted);font-size:16px}.routing-timeline{position:relative;display:grid;gap:19px;margin:0;padding:27px 0 28px 50px;list-style:none}.routing-timeline:before{position:absolute;top:20px;bottom:20px;left:14px;width:2px;background:var(--line);content:""}.routing-timeline li{position:relative;display:flex;gap:16px;align-items:flex-start}.routing-timeline li>span{position:absolute;z-index:1;left:-43px;top:6px;width:14px;height:14px;border:3px solid var(--paper);border-radius:50%;background:var(--ink);box-shadow:0 0 0 1px var(--line)}.routing-timeline div{display:grid;gap:3px}.routing-timeline strong{font-size:15px;font-weight:650}.routing-timeline small,.routing-confirmation small{color:var(--muted);font-size:14px}.routing-confirmation{display:grid;gap:7px;padding:23px}.routing-confirmation p{margin:0;font-size:18px;font-weight:680}.routing-confirmation strong{font-size:17px}.routing-confirmation a{width:max-content;margin-top:8px;padding:10px 15px;border-radius:7px;background:var(--ink);color:var(--paper);font-size:14px;font-weight:650;text-decoration:none}.routing-confirmation a span{margin-left:8px;font-size:18px}@media(max-width:820px){.routing-progress{margin-top:24px}.routing-request{font-size:14px}.routing-timeline{padding-left:42px}.routing-timeline li>span{left:-35px}}</style></body></html>
