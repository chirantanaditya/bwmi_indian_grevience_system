---
import "../styles/tailwind.css";
import "../styles/global.css";
import { LoginForm } from "../components/login-form";
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Sign in — IGS</title></head>
  <body class="min-h-screen bg-background text-foreground">
    <main class="mx-auto flex min-h-screen w-full max-w-xl flex-col justify-center px-5 py-12">
      <a class="mb-10 text-4xl font-black tracking-[-0.08em]" href="/">IGS</a>
      <LoginForm client:load />
    </main>
  </body>
